# 复制为 .env（chmod 600）后填写
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 加密绑定数据用的密钥：openssl rand -hex 32 生成。不要改、不要外传（改了以后所有人要重新绑定）
BIND_KEY=

# 可选：报销网站地址（默认 http://10.1.2.247）
# INTRANET_URL=http://10.1.2.247
# 可选：管理员与 fs 助手单聊的 chat_id，提醒和 send-me 发到这里
# FEISHU_OWNER_CHAT=oc_xxxxxxxx
